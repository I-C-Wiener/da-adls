# Copy this file to .env and fill in values for local development.
# Never commit .env to git.

# PostgreSQL
POSTGRES_PASSWORD=chat_secret

# Play Framework
APPLICATION_SECRET=change_me_must_be_at_least_32_characters_long

# JWT
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRY_HOURS=72

# Message expiration (0 = messages never expire)
MESSAGE_EXPIRATION_DAYS=30

# File upload limits (MB)
MAX_FILE_SIZE_MB=20
MAX_IMAGE_SIZE_MB=3
